---
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props { href: string; variant: 'primary' | 'secondary'; block?: boolean; arrow?: boolean }
const { href, variant, block = false, arrow = variant === 'primary' } = Astro.props;
---
<a class:list={['btn', variant === 'primary' ? 'btn--primary' : 'btn--secondary', block && 'btn--block']} href={url(href)}>
  <slot />
  {arrow && <Icon name="arrow-right" />}
</a>
