---
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  icon: string;
  rows: { dt: string; dd: string; href?: string }[];
}
const { title, icon, rows } = Astro.props;
// microcopy fiche.aria (SPEC §4.3)
const ariaLabel = 'Resumen del servicio';
---
<aside class="fiche" aria-label={ariaLabel}>
  <div class="fiche__head"><span class="icon-badge"><Icon name={icon} /></span>{title}</div>
  <dl>
    {rows.map(r => (
      <div class="fiche__row">
        <dt>{r.dt}</dt>
        <dd>{r.href ? <a href={url(r.href)}>{r.dd}</a> : r.dd}</dd>
      </div>
    ))}
  </dl>
</aside>
