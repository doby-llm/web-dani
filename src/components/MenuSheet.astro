---
import Icon from './Icon.astro';
import { services, primary } from '../lib/nav';
import { url } from '../lib/url';
import shared from '../data/copy/shared.json';

// Sheet lists the same services and information links as the desktop menu, plus the FAQ.
const faqLabel = shared.footer.columns[1].links[4];
---
<div class="sheet" id="menu-sheet" data-open="false" inert>
  <div class="sheet__top">
    <a class="brand" href={url('')}>
      <span class="brand__mark" aria-hidden="true">DC</span>
      <span class="brand__text"><span class="brand__name">{shared.header.brand_name}</span><span class="brand__role">{shared.header.brand_role}</span></span>
    </a>
    <button class="nav-toggle" type="button" data-close-sheet style="display:inline-flex"><Icon name="x" />Cerrar</button>
  </div>
  <p class="sheet__group-label">Servicios</p>
  <ul class="sheet__list">
    {services.map(s => (
      <li><a href={url(s.path)}>{s.title}<Icon name="chevron-right" /></a></li>
    ))}
  </ul>
  <p class="sheet__group-label">{shared.footer.columns[1].heading}</p>
  <ul class="sheet__list">
    {primary.map(p => (
      <li><a href={url(p.path)}>{p.label}<Icon name="chevron-right" /></a></li>
    ))}
    <li><a href={url('preguntas-frecuentes/')}>{faqLabel}<Icon name="chevron-right" /></a></li>
  </ul>
  <div class="sheet__cta"><a class="btn btn--primary btn--block" href={url('contacto/')}>{shared.floating.mobile_contact_bar}</a></div>
</div>
