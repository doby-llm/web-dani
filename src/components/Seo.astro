---
import { getEntry } from 'astro:content';
import { INDEXABLE } from '../lib/env';
import { SITE_NAME, absolute, color, jsonLd, seo } from '../lib/seo';
import { url } from '../lib/url';

interface Props {
  key: string;
  type?: 'website' | 'article';
  article?: { published: string; modified?: string };
  titleOverride?: string;
  descriptionOverride?: string;
}
const { key, type = 'website', article, titleOverride, descriptionOverride } = Astro.props;

// Articles are not in seo.json: their title and description come from the blog entry (BaseLayout passes the overrides).
const post = type === 'article' ? await getEntry('blog', key) : undefined;
const entry = seo[key];
if (!post && !entry) throw new Error(`Seo: no seo.json entry for "${key}"`);

const path = post ? `blog/${key}/` : entry.path;
const title = entry?.title ?? titleOverride!;
const description = entry?.description ?? descriptionOverride!;
const ogTitle = post?.data.title ?? entry.ogTitle;
const imageAlt = `${ogTitle} — Daniel Clemente, nutricionista`;
const canonical = absolute(path);
const image = absolute(`og/${entry?.ogImage ?? key}.png`);
const crumbs = post
  ? [{ name: 'Inicio', path: '' }, { name: 'Blog', path: 'blog/' }, { name: post.data.title, path }]
  : entry.crumbs;
const graph = jsonLd({
  key,
  path,
  crumbs,
  article: post && article ? { headline: post.data.title, description, ...article } : undefined,
});
const robots = INDEXABLE && key !== '404' ? 'index,follow,max-image-preview:large' : 'noindex,nofollow';
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="theme-color" content={color('brand')} />
<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={url('favicon-32.png')} sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
<link rel="manifest" href={url('site.webmanifest')} />
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{post && article && <meta property="article:published_time" content={article.published} />}
{post && article?.modified && <meta property="article:modified_time" content={article.modified} />}
{post && <meta property="article:author" content={absolute('sobre-mi/')} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
