---
// The three ported sheets are imported here. global.css does not exist (T01 did not create it).
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import serifFont from '../assets/fonts/fraunces-web.woff2?url';
import italicFont from '../assets/fonts/fraunces-italic-web.woff2?url';
import italicFont from '../assets/fonts/fraunces-italic-web.woff2?url';
import sansFont from '../assets/fonts/public-sans-web.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import MenuSheet from '../components/MenuSheet.astro';
import Seo from '../components/Seo.astro';
import { PROVISIONAL } from '../lib/env';
import shared from '../data/copy/shared.json';

interface Props {
  title: string;
  description: string;
  ogSlug: string;
  current?: 'como' | 'programas' | 'sobre' | 'blog' | 'servicios';
  hideActionBar?: boolean;
  article?: { published: string; modified?: string };
}
const { title, description, ogSlug, current, hideActionBar = false, article } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo key={ogSlug} type={article ? 'article' : 'website'} article={article} titleOverride={title} descriptionOverride={description} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{shared.skip_link}</a>
    {PROVISIONAL && <p class="site-notice">{shared.site_notice}</p>}
    <Header current={current} />
    <slot />
    <Footer />
    <ActionBar hidden={hideActionBar} />
    <MenuSheet />
    <script src="../scripts/site.js"></script>
  </body>
</html>

<style is:global>
  /* C1 touch-target patch for R1-01; frozen CSS untouched; tokens only. */
  .link-arrow { padding-block: var(--s-3); margin-block: calc(var(--s-3) * -1); }
  /* Same patch for the Fiche links (inline in a dd): vertical padding only, no layout change. Fiche.astro is not in the C1 allowlist. */
  .fiche__row a { padding-block: var(--s-4); }
  /* CV lists (Formación on home and Sobre mí): stacked lines had no marker; add a brand dot like the other lists. */
  .cv__row dd ul li { display: grid; grid-template-columns: 0.5rem minmax(0, 1fr); column-gap: var(--s-3); align-items: start; }
  .cv__row dd ul li::before { content: ""; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--brand); margin-top: calc(0.8em - 0.25rem); }
  /* Mobile: the space reserved for the fixed action bar was body padding, which showed as a cream strip under the green footer.
     Move it inside the footer so the green reaches the bottom edge (frozen components.css untouched). */
  @media (max-width: 899px) {
    html body { padding-bottom: 0; }
    .site-footer { padding-bottom: calc(4.25rem + env(safe-area-inset-bottom)); }
  }
</style>
