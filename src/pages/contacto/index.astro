---
// Contacto: short informative form. Without FORM_ENDPOINT it is a demo: site.js (6, 6b) validates and shows the prototype result, nothing is sent.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import Note from '../../components/Note.astro';
import Still from '../../components/Still.astro';
import { FORM_ENDPOINT } from '../../lib/env';
import contacto from '../../data/copy/contacto.json';
import comoFunciona from '../../data/copy/como-funciona.json';
import avocado from '../../assets/img/avocado.png';
import lemonB from '../../assets/img/lemon-b.png';

const canales = contacto.sections.find(s => s.id === 'canales')!;
const formulario = contacto.sections.find(s => s.id === 'formulario')!;
const espera = comoFunciona.sections.find(s => s.id === 'que-se-espera')!;
const [nombre, email, whatsapp, objetivo, mensaje] = contacto.form.fields;
const bare = (label: string) => label.replace(/\s*\*$/, '');

// Channel icons follow the order of canales.items (WhatsApp, Email, Reserva).
const channelIcons = ['message-circle', 'mail', 'calendar-days'];

// Chip values: site.js 6b aliases (?objetivo=) rely on these exact strings.
const goalValues: Record<string, string> = {
  'Pérdida de peso': 'perdida-de-peso',
  'Reducción de grasa': 'reduccion-de-grasa',
  'Mejora de composición corporal': 'composicion',
  'Ganancia de masa muscular': 'masa-muscular',
  'Rendimiento o recuperación deportiva': 'rendimiento',
  'Apoyo nutricional clínico': 'clinico',
};
const goals = objetivo.options!.map(label => ({ label, value: goalValues[label] }));

// Microcopy §4.3: form.optional, form.err.*, form.ok.*, form.err.send, nav.contact.
const optional = 'opcional';
const errName = 'Escribe tu nombre.';
const errEmail = 'Revisa el email: falta algo (por ejemplo, @gmail.com).';
const okTitle = 'Datos validados.';
const okProto = 'Esta demo no envía ni guarda nada. Cuando los canales estén confirmados, aquí te diré cuándo responderé.';
const okLive = 'Mensaje enviado. Te responderé lo antes posible.';
const errSend = 'No se ha podido enviar. Inténtalo de nuevo en unos minutos.';
const navContact = 'Contacto';
---
<BaseLayout
  title="Contacto · Daniel Clemente, nutricionista"
  description="Cuéntame tu objetivo y revisa qué programa encaja mejor contigo."
  ogSlug="contacto"
  hideActionBar
>
  <main id="main">
    <section class="page-hero page-hero--v4 bg-weight" aria-labelledby="ph-title">
      <div class="container">
        <Breadcrumb items={[{ label: 'Inicio' }, { label: navContact }]} />
        <div class="page-hero__grid">
          <div>
            <!-- R22(d): the mockup's italic phrase is not in the copy h1, so no accent (n = 0). -->
            <h1 id="ph-title">{contacto.h1}</h1>
            <p class="lead">{contacto.lead}</p>
          </div>
          <div class="page-hero__aside">
            <Still
              settle
              style="position:relative;inset:auto;width:100%;height:14rem"
              objects={[
                { src: lemonB, w: '44%', right: '4%', top: '0', rotate: 10 },
                { src: avocado, w: '34%', left: '8%', bottom: '0', rotate: -10 },
              ]}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-paper" aria-labelledby="form-title">
      <div class="container split split--5-7" style="align-items:start">
        <aside>
          <ul class="channels">
            {canales.items!.map((item, i) => (
              <li class="channel">
                <span class="icon-badge"><Icon name={channelIcons[i]} /></span>
                <div><h3>{item.title}</h3><p>{item.text}</p></div>
              </li>
            ))}
          </ul>
          <div class="panel" style="margin-top:var(--s-5)">
            <h3>{espera.heading}</h3>
            <p style="margin-top:var(--s-2)">{espera.paragraphs[0]}</p>
          </div>
        </aside>

        <div class="panel">
          <h2 id="form-title">{formulario.heading}</h2>
          <div style="margin-top:var(--s-4)">
            <Note note={{ text: formulario.disclaimers![0].text, kind: 'legal' }} boxed icon="shield-check" />
          </div>

          <form class="form" data-contact novalidate data-endpoint={FORM_ENDPOINT} method="post" action={FORM_ENDPOINT || undefined} style="margin-top:var(--s-6)">
            <div class="form__row">
              <div class="field">
                <label class="field__label" for="f-name">{bare(nombre.label)}<span aria-hidden="true"> *</span></label>
                <input class="input" id="f-name" name="nombre" type="text" placeholder={nombre.placeholder} autocomplete="name" required aria-describedby="f-name-err" />
                <p class="field__error" id="f-name-err"><Icon name="info" class="icon--s" />{errName}</p>
              </div>
              <div class="field">
                <label class="field__label" for="f-email">{bare(email.label)}<span aria-hidden="true"> *</span></label>
                <input class="input" id="f-email" name="email" type="email" placeholder={email.placeholder} autocomplete="email" required aria-describedby="f-email-err" />
                <p class="field__error" id="f-email-err"><Icon name="info" class="icon--s" />{errEmail}</p>
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="f-wa">{bare(whatsapp.label)} <span class="field__opt">{optional}</span></label>
              <input class="input" id="f-wa" name="whatsapp" type="tel" inputmode="tel" placeholder={whatsapp.placeholder} autocomplete="tel" />
            </div>

            <fieldset class="field goal-chips">
              <legend class="field__label">{bare(objetivo.label)}</legend>
              {goals.map((goal, i) => (
                <label class="goal-chip">
                  <input type="radio" name="objetivo" value={goal.value} checked={i === 0} />
                  <span>{goal.label}</span>
                </label>
              ))}
            </fieldset>

            <div class="field">
              <label class="field__label" for="f-msg">{bare(mensaje.label)}</label>
              <textarea class="input" id="f-msg" name="mensaje" maxlength="1200" placeholder={mensaje.placeholder}></textarea>
            </div>

            <input type="hidden" name="programa" value="" />
            <div class="visually-hidden" aria-hidden="true">
              <label>Empresa<input name="empresa" tabindex="-1" autocomplete="off" /></label>
            </div>

            <button class="btn btn--primary btn--block" type="submit">{contacto.form.submit}<Icon name="arrow-right" /></button>
            {!FORM_ENDPOINT && <Note note={{ text: contacto.form.notes[0].text, kind: 'provisional' }} />}
          </form>

          <div class="form-status" role="status" tabindex="-1" style="margin-top:var(--s-5)">
            <div data-when="success">
              <Icon name="check" class="icon--l" />
              <div>
                {!FORM_ENDPOINT && <strong>{okTitle}</strong>}
                <p>{FORM_ENDPOINT ? okLive : okProto}</p>
              </div>
            </div>
            <div data-when="error">
              <Icon name="info" class="icon--l" />
              <div><p>{errSend}</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Layout only: each status variant is a flex row; site.js sets data-state. */
  .form-status > [data-when] { display: flex; gap: var(--s-3); align-items: flex-start; }
  .form-status[data-state="success"] [data-when="error"],
  .form-status[data-state="error"] [data-when="success"] { display: none; }
</style>
