---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
import Note from '../../components/Note.astro';
import Still from '../../components/Still.astro';
import { primary } from '../../lib/nav';
import avocado from '../../assets/img/avocado.png';
import grapefruit from '../../assets/img/grapefruit.png';
import lemonA from '../../assets/img/lemon-a.png';
import lemonC from '../../assets/img/lemon-c.png';
import portrait from '../../assets/img/portrait.webp';
import home from '../../data/copy/home.json';
import sobre from '../../data/copy/sobre-mi.json';

const sec = (id: string) => sobre.sections.find(s => s.id === id)!;
const formacion = sec('formacion');
const experiencia = sec('experiencia');
const docencia = sec('docencia-enfoque');
const band = home.sections.find(s => s.id === 'cta-banner')!;
const label = primary.find(p => p.key === 'sobre')!.label;
// Microcopy tag.portrait (SPEC §4.3).
const portraitTag = 'Evidencia · + cercanía';
---
<BaseLayout title="Sobre mí · Daniel Clemente, nutricionista" description="Grado en nutrición (UEM), máster en endocrinología y nutrición clínica (UCAM) y más de 8 años con pacientes online." ogSlug="sobre-mi" current="sobre">
  <main id="main">
    <section class="page-hero page-hero--v4 bg-weight" aria-labelledby="ph-title">
      <div class="container">
        <Breadcrumb items={[{ label: 'Inicio', href: '' }, { label }]} />
        <div class="page-hero__grid">
          <div>
            <h1 id="ph-title">{sobre.h1}</h1>
            <p class="lead">{sobre.lead}</p>
            <div class="btn-row btn-row--stack" data-action-bar-trigger>
              <Button href="contacto/" variant="primary">{sobre.hero_ctas[0]}</Button>
              <Button href="programas/" variant="secondary">{sobre.hero_ctas[1]}</Button>
            </div>
          </div>
          <div class="page-hero__aside">
            <Still
              settle
              objects={[
                { src: grapefruit, w: '44%', right: '6%', top: '4%', rotate: -10 },
                { src: lemonC, w: '36%', left: '6%', bottom: '0', rotate: 14 },
              ]}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-paper" aria-labelledby="formacion-title">
      <div class="container profile">
        <figure>
          <div class="portrait">
            <Image
              src={portrait}
              widths={[480, 768]}
              sizes="(max-width: 899px) 100vw, 40vw"
              loading="lazy"
              alt={formacion.images[0].alt}
            />
          </div>
          <figcaption class="portrait-caption">{portraitTag}</figcaption>
        </figure>
        <div>
          <div class="sec-head sec-head--stack">
            <h2 id="formacion-title">{formacion.heading}</h2>
          </div>
          <dl class="cv">
            <div class="cv__row">
              <dt>{formacion.heading}</dt>
              <dd>
                <ul>
                  {formacion.items.map(item => <li>{item.text}</li>)}
                </ul>
              </dd>
            </div>
            <div class="cv__row">
              <dt>{experiencia.heading}</dt>
              <dd>{experiencia.paragraphs[0]}</dd>
            </div>
            <div class="cv__row">
              <dt>{docencia.heading}</dt>
              <dd>{docencia.paragraphs[0]}</dd>
            </div>
          </dl>
          <Note note={{ text: formacion.disclaimers[0].text, kind: 'editorial' }} />
          <Note note={{ text: docencia.disclaimers[0].text, kind: 'editorial' }} />
        </div>
      </div>
    </section>

    <section class="cta-band cta-band--v4 bg-brand on-dark" aria-labelledby="cta-title" data-hide-action-bar>
      <div class="container cta-band__inner">
        <div>
          <h2 id="cta-title">{band.heading}</h2>
          <div class="btn-row btn-row--stack" style="margin-top:var(--s-6)">
            <Button href="contacto/" variant="primary">{home.hero_ctas[0]}</Button>
          </div>
        </div>
        <Still
          objects={[
            { src: avocado, w: '44%', right: '4%', top: '4%', rotate: 14 },
            { src: lemonA, w: '38%', left: '10%', bottom: '0', rotate: -12 },
          ]}
        />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero__aside :global(.still) { position: relative; inset: auto; width: 100%; height: 14rem; }
  .profile > div > :global(.note) { margin-top: var(--s-4); }
  .profile > div > :global(.note:first-of-type) { margin-top: var(--s-5); }
</style>
